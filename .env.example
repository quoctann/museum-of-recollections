# Documentation only. `make setup` generates random local credentials in .env.
POSTGRES_USER=museum
POSTGRES_DB=museum
POSTGRES_PORT=55432
POSTGRES_PASSWORD=replace-with-random-local-password
DATABASE_URL=postgres://museum:replace-with-random-local-password@localhost:55432/museum?sslmode=disable
DATABASE_URL_CONTAINER=postgres://museum:replace-with-random-local-password@postgres:5432/museum?sslmode=disable
MINIO_ROOT_USER=replace-with-local-access-key
MINIO_ROOT_PASSWORD=replace-with-random-local-storage-password
API_PORT=8080
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=replace-with-local-access-key
S3_SECRET_KEY=replace-with-random-local-storage-password
S3_BUCKET=recollections
S3_USE_SSL=false
